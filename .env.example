# TURN relay (WebRTC fallback when peers cannot connect directly)
TURN_URL=turn:your-turn-host:3478
TURN_USERNAME=
TURN_PASSWORD=

# Google sign-in. An OAuth "Web application" client ID from Google Cloud
# Console; add every origin the app runs on (https://your-app.onrender.com,
# http://localhost:3000) under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# Long random string. Signs session cookies, so changing it signs everyone out.
SESSION_SECRET=

# Optional demo access: when set, /auth/test-login?code=<value> mints a session
# without Google. Add &as=b for a second identity to match against yourself.
# Leave unset to disable the endpoint entirely (it 404s).
TEST_LOGIN_CODE=

# Admin board at /admin. Comma-separated Google emails; they sign in as usual.
# Everyone else gets a 404 there.
ADMIN_EMAILS=

# Optional Postgres for the admin board's analytics (any provider). Without
# it the board shows live data only. Locally: `npm run db:local`, then
# DATABASE_URL=postgres://postgres:postgres@localhost:5433/meetastu
DATABASE_URL=
