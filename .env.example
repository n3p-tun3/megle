# TURN relay (WebRTC fallback when peers cannot connect directly)
TURN_URL=turn:your-turn-host:3478
TURN_USERNAME=
TURN_PASSWORD=

# Auth. Comma-separated list; subdomains of each entry are also accepted.
# Leave unset in local dev to allow any email domain.
ALLOWED_EMAIL_DOMAINS=

# Long random string. Signs session cookies, so changing it signs everyone out.
SESSION_SECRET=

# Mail delivery. Without these, magic links print to the server log instead.
RESEND_API_KEY=
MAIL_FROM=megle <login@yourdomain.com>
