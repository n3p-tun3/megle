# TURN relay (WebRTC fallback when peers cannot connect directly)
TURN_URL=turn:your-turn-host:3478
TURN_USERNAME=
TURN_PASSWORD=

# Auth. Comma-separated; subdomains of each entry are also accepted.
# Defaults to astust.edu.et when unset. Use "*" to allow any domain locally.
ALLOWED_EMAIL_DOMAINS=astust.edu.et

# Long random string. Signs session cookies, so changing it signs everyone out.
SESSION_SECRET=

# Mail delivery. Without both of these, magic links print to the server log.
# MAIL_FROM must be on a domain you have verified with Resend.
RESEND_API_KEY=
MAIL_FROM=megle <login@yourdomain.com>

# Optional demo access: when set, /auth/test-login?code=<value> mints a session
# without email. Add &as=b for a second identity to match against yourself.
# Leave unset to disable the endpoint entirely (it 404s).
TEST_LOGIN_CODE=
